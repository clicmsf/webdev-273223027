# The platform supplies this in production. Local default: 3000.
PORT=3000

# Neon dashboard → Connect. Copy its Postgres connection string.
DATABASE_URL=

# Optional SQLite path for standalone MCP when DATABASE_URL is unset.
DB_PATH=.local/club.db

# Choose a private password of at least eight characters for npm run setup.
SEED_PASSWORD=

# Create a key in Google AI Studio. Leave blank for manual poster entry.
GEMINI_API_KEY=

# Use a valid Club Events session for authenticated local MCP project tools.
CLUB_SESSION_TOKEN=

# Google Cloud OAuth client credentials. The sign-in integration is configured in Exercise 4.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
